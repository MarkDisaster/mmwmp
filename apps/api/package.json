{
   "name": "@mm/api",
   "version": "0.0.0",
   "private": true,
   "scripts": {
      "build": "nest build",
      "dev": "nest start --watch",
      "generate": "prisma generate",
      "start": "node dist/src/main",
      "start:prod": "node dist/src/main",
      "lint": "eslint \"{src,test}/**/*.ts\" --fix --max-warnings 0",
      "lint:ci": "eslint \"{src,test}/**/*.ts\" --max-warnings 0",
      "typecheck": "tsc --noEmit -p tsconfig.spec.json",
      "test": "NODE_OPTIONS=--experimental-vm-modules node --no-compilation-cache node_modules/jest/bin/jest.js --runInBand --detectOpenHandles",
      "test:unit": "NODE_OPTIONS=--experimental-vm-modules jest --config jest.unit.config.ts",
      "test:unit:watch": "NODE_OPTIONS=--experimental-vm-modules jest --config jest.unit.config.ts --watch",
      "seed": "tsx prisma/seed.ts"
   },
