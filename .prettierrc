{
  "semi": true,
  "singleQuote": true,
  "trailingComma": "all",
  "printWidth": 100,
  "tabWidth": 3,
  "arrowParens": "always",
  "endOfLine": "lf",
  "overrides": [
    {
      "files": ["apps/admin/**", "apps/web/**"],
      "options": {
        "plugins": ["prettier-plugin-tailwindcss"],
        "tailwindFunctions": ["cn", "clsx", "cva"]
      }
    },
    {
      "files": "apps/admin/**",
      "options": { "tailwindStylesheet": "./apps/admin/src/globals.css" }
    },
    {
      "files": "apps/web/**",
      "options": { "tailwindStylesheet": "./apps/web/src/app/globals.css" }
    }
  ]
}
