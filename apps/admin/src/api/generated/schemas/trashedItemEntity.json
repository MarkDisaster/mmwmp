{
   "type": "object",
   "properties": {
      "id": { "type": "number" },
      "title": { "type": "string", "description": "Title, name or file name" },
      "originalSlug": {
         "type": "string",
         "nullable": true,
         "description": "Slug before the row was trashed"
      },
      "deletedAt": { "format": "date-time", "type": "string" },
      "deletedBy": {
         "nullable": true,
         "type": "object",
         "allOf": [
            {
               "type": "object",
               "properties": {
                  "id": { "type": "number" },
                  "firstName": { "type": "string" },
                  "lastName": { "type": "string" },
                  "email": {
                     "type": "string",
                     "description": "Sent only to a caller with the `users.read` permission, or to the author."
                  }
               },
               "required": ["id", "firstName", "lastName"],
               "x-readme-ref-name": "AuthorEntity"
            }
         ]
      },
      "daysLeft": {
         "type": "number",
         "description": "Days left before the automatic purge (0 when it is due)"
      }
   },
   "required": ["id", "title", "originalSlug", "deletedAt", "deletedBy", "daysLeft"],
   "x-readme-ref-name": "TrashedItemEntity"
}
