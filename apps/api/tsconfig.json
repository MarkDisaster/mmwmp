{
   "extends": "../../tsconfig.base.json",
   "compilerOptions": {
      "module": "CommonJS",
      "moduleResolution": "Node",
      "outDir": "dist",
      "rootDir": ".",
      "emitDecoratorMetadata": true,
      "experimentalDecorators": true,
      "declaration": false,
      "declarationMap": false,
      "baseUrl": ".",
      "paths": {
         "@/generated/*": ["./prisma/generated/*"],
         "@/*": ["./src/*"]
      }
   },
   "include": ["src", "prisma/generated"]
}
