{
   "name": "@mm/web",
   "version": "0.0.0",
   "private": true,
   "scripts": {
      "dev": "next dev --turbopack -p 3047",
      "build": "next build",
      "start": "next start",
      "lint": "eslint \"src/**/*.{ts,tsx}\" --fix --max-warnings 0",
      "lint:ci": "eslint \"src/**/*.{ts,tsx}\" --max-warnings 0",
      "typecheck": "next typegen && tsc --noEmit",
      "test:unit": "vitest run",
      "test:unit:fast": "vitest run --exclude \"**/course-{bot,fair}-*.test.ts\"",
      "test:unit:watch": "vitest --exclude \"**/course-{bot,fair}-*.test.ts\"",
      "storybook": "storybook dev -p 6047",
      "build-storybook": "storybook build",
      "generate:api": "curl -sf http://localhost:3247/api/docs/json -o ./src/api/schema.json && kubb generate",
      "generate:docgen": "react-docgen --pretty --resolver find-all-exported-components --ignore 'src/**/*.stories.tsx' --ignore 'src/**/*.test.tsx' --ignore 'src/**/JsonLd.tsx' --ignore 'src/**/CursorFollower.tsx' --ignore 'src/**/RunnerGame.tsx' --out public/react-docgen.json 'src/components/**/*.tsx' 'src/features/**/components/*.tsx'"
   },
   "dependencies": {
      "@mm/tokens": "workspace:*",
      "@mm/utils": "workspace:*",
      "@radix-ui/react-dialog": "^1.1.15",
      "@radix-ui/react-select": "^2.2.6",
      "@radix-ui/react-slot": "^1.2.4",
      "@radix-ui/react-switch": "^1.2.6",
      "@sentry/nextjs": "^11.12.0",
      "@t3-oss/env-nextjs": "^0.13.11",
      "axios": "^1.14.0",
      "libphonenumber-js": "^1.12.42",
      "motion": "^12",
      "next": "^15",
      "next-intl": "^4",
      "next-themes": "^0.4.6",
      "react": "^19",
      "react-dom": "^19",
      "zod": "^4.4.3"
   },
   "devDependencies": {
      "@chromatic-com/storybook": "^4",
      "@kubb/cli": "^4.37.0",
      "@kubb/core": "^4.37.0",
      "@kubb/plugin-client": "^4.37.0",
      "@kubb/plugin-oas": "^4.37.0",
      "@kubb/plugin-ts": "^4.37.0",
      "@react-docgen/cli": "^3",
      "@storybook/addon-a11y": "^10",
      "@storybook/addon-docs": "^10",
      "@storybook/addon-themes": "^10",
      "@storybook/nextjs": "^10",
      "@svgr/webpack": "^8",
      "@tailwindcss/postcss": "^4",
      "@tailwindcss/typography": "^0.5.20",
      "@types/node": "^22",
      "@types/react": "^19",
      "@types/react-dom": "^19",
      "happy-dom": "^20.14.6",
      "postcss": "^8",
      "storybook": "^10",
      "tailwindcss": "^4",
      "typescript": "^5",
      "vercel": "50.44.0",
      "vitest": "^3"
   }
}
