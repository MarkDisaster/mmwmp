{
   "$schema": "https://turborepo.dev/schema.json",
   "extends": ["//"],
   "tasks": {
      "build": {
         "dependsOn": ["^build", "generate", "typecheck"]
      },
      "typecheck": {
         "dependsOn": ["topo", "generate"],
         "env": ["NEXT_PUBLIC_*", "ROBOTS_NOINDEX", "ENABLE_DOMAIN_REDIRECTS"]
      }
   }
}
