{
   "name": "@mm/admin",
   "version": "0.0.0",
   "private": true,
   "type": "module",
   "scripts": {
      "dev": "vite",
      "prebuild": "pnpm generate:docgen",
      "build": "tsc --noEmit && vite build",
      "preview": "vite preview",
      "lint": "eslint \"src/**/*.{ts,tsx}\" --fix --max-warnings 0",
      "lint:ci": "eslint \"src/**/*.{ts,tsx}\" --max-warnings 0",
      "typecheck": "tsc --noEmit",
      "storybook": "storybook dev -p 6147",
      "test:unit": "vitest run",
      "build-storybook": "storybook build",
      "generate:api": "curl -sf \"${API_URL:-http://localhost:3247}/api/docs/json\" -o ./src/api/schema.json && kubb generate",
      "generate:docgen": "react-docgen --pretty --resolver find-all-exported-components --ignore 'src/**/*.stories.tsx' --ignore 'src/**/*.test.tsx' --out public/react-docgen.json 'src/components/**/*.tsx' 'src/features/**/components/*.tsx'"
   },
   "dependencies": {
