      "@sentry/react": "^11.12.0",
      "@tanstack/query-sync-storage-persister": "^5.95.2",
      "@tanstack/react-query": "^5",
      "@tanstack/react-query-persist-client": "^5.95.2",
      "@tanstack/react-router": "^1",
      "@tanstack/react-table": "^8.21.3",
      "@tiptap/extension-heading": "^3.20.5",
      "@tiptap/extension-image": "^3.20.5",
      "@tiptap/extension-placeholder": "^3.20.5",
      "@tiptap/extension-table": "3.23.1",
      "@tiptap/markdown": "3.23.1",
      "@tiptap/pm": "3.23.1",
      "@tiptap/react": "^3.20.5",
      "@tiptap/starter-kit": "^3.20.5",
      "ai": "^6.0.326",
      "axios": "^1",
