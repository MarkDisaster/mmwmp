      "@hookform/resolvers": "^5.2.2",
      "@mm/tokens": "workspace:*",
      "@mm/utils": "workspace:*",
      "@radix-ui/react-avatar": "^1",
      "@radix-ui/react-dropdown-menu": "^2",
      "@radix-ui/react-label": "^2",
      "@radix-ui/react-popover": "^1.1.15",
