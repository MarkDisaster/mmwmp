# Runtime connection used by the app. On Neon use the pooled host (`-pooler`).
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
# Direct (non-pooled) connection used by `prisma migrate`.
# On Neon: the same URL without `-pooler` in the host name. Optional locally.
DATABASE_URL_UNPOOLED="postgresql://user:password@host/dbname?sslmode=require"

JWT_SECRET="change-me-to-a-random-value-of-32-or-more-characters"
JWT_EXPIRATION="900" # 15 minutes (in seconds)
JWT_REFRESH_SECRET="change-me-to-a-random-value-of-32-or-more-characters"
JWT_REFRESH_EXPIRATION="604800" # 7 days (in seconds)

# Redis (BullMQ background jobs, cache, rate limiting) — Aiven Valkey, TCP URL.
# Format: rediss://default:<password>@<host>:<port>
# Take the Service URI from the Aiven console (service overview).
REDIS_URL="rediss://default:change-me@change-me.aivencloud.com:12345"
# Optional namespace of every key: queues (`<prefix>:bull:*`), cache, rate limits. Unset keeps the
# keys without a prefix (`bull:*`). Staging and production MUST use different values when they
# share one Valkey instance, otherwise the queues and job schedulers of one replace the other's.
# Letters, digits, _ and - (at most 32). Changing it leaves the old keys behind (see docs/DEVELOPMENT.md).
# REDIS_KEY_PREFIX="staging"

RESEND_API_KEY="change-me"
EMAIL_FROM="noreply@marek.media"
ADMIN_URL="http://localhost:3147"
CORS_ORIGINS="http://localhost:3147,http://localhost:5173"
# Which environment this is (`development`, `staging`, `production`, `test`). REQUIRED: the API does
# not start without it. Written to every log line. `staging` and `production` need
# NODE_ENV=production (how the app runs: `production` on every deployed environment, staging too).
# NODE_ENV="development"
APP_ENV="development"
# Swagger UI and JSON (`/api/docs`): on outside production, off with NODE_ENV=production. "true" or
# "false" overrides it (docs/DEVELOPMENT.md, "Nasazení: zpřísnění oprávnění").
# SWAGGER_ENABLED="false"
# HTTP Basic auth of the documentation. Optional, but both or neither (the API does not start with
# one of them); the password needs 16+ characters: `openssl rand -base64 24`. Without them an
# enabled documentation is open and the API logs a warning at start.
# SWAGGER_USERNAME="change-me"
# SWAGGER_PASSWORD="change-me-to-a-random-value"

# Draft preview (docs/DEVELOPMENT.md, "Náhled: oddělené secrety"). Two different random values, the
# same two on the web, different per environment: `openssl rand -base64 48`.
# Signs the 5-minute token of a preview link (`/api/draft?token=...`); the key itself never leaves
# the servers.
PREVIEW_URL_SIGNING_KEY="change-me-to-a-random-value-of-32-or-more-characters"
# Bearer token the web sends to read drafts (`GET /public/...`). Server-only, never in a URL.
PREVIEW_API_TOKEN="change-me-to-another-random-value-of-32-or-more-chars"
# Deprecated: the old single secret, put into the preview links. Only a fallback while one of the
# two above is unset (a warning at start-up); leave it unset.
# PREVIEW_SECRET="change-me"
WEB_URL="http://localhost:3000"
# Shared secret of the web `/api/revalidate` (the API calls it after content changes). REQUIRED, at
# least 32 characters, the same value as `REVALIDATE_SECRET` of the web: `openssl rand -base64 48`.
REVALIDATE_SECRET="change-me-to-a-random-value-of-32-or-more-characters"

# Cloudflare R2 (file storage)
R2_ACCESS_KEY_ID="change-me"
R2_SECRET_ACCESS_KEY="change-me"
# Only for the local S3 mock (docker compose): path-style addressing. Leave unset for Cloudflare R2.
# R2_FORCE_PATH_STYLE="true"
R2_ENDPOINT="https://your-account-id.r2.cloudflarestorage.com"
R2_BUCKET="your-bucket-name"
R2_PUBLIC_URL="https://your-bucket.r2.dev"

# Daily cleanup of old runner game scores (BullMQ job, 03:30 UTC). On unless "false"; set it to
# "false" and restart the service to stop it (see docs/DEVELOPMENT.md).
# RUNNER_SCORE_CLEANUP_ENABLED="true"

# Trash (Koš) of projects, services, tags and files: a daily BullMQ job (04:15 UTC) deletes rows that
# were in the trash longer than TRASH_RETENTION_DAYS (default 30). On unless "false"; set it to
# "false" and restart the service to stop it (see docs/DEVELOPMENT.md).
# TRASH_PURGE_ENABLED="true"
# TRASH_RETENTION_DAYS="30"

# AI / LLM providers
# The key of the provider in LLM_PROVIDER is required with NODE_ENV=production (docs/DEVELOPMENT.md,
# "AURORA: poskytovatel modelu"); any other LLM_PROVIDER value stops the start.
LLM_PROVIDER="google" # google | anthropic
GOOGLE_GENERATIVE_AI_API_KEY="change-me" # https://aistudio.google.com/apikey
ANTHROPIC_API_KEY="change-me" # https://console.anthropic.com
OPENAI_API_KEY="change-me" # https://platform.openai.com — Whisper (STT) + TTS for AURORA voice mode
# Limits of AURORA chat (docs/DEVELOPMENT.md, "AURORA: limity nákladů"); unset uses the defaults.
# AI_CHAT_MAX_OUTPUT_TOKENS="16384" # per model call, 1024-65536
# AI_CHAT_TURN_TIMEOUT_MS="300000" # whole turn, 30000-900000
# HMAC key of AURORA tool approvals (docs/DEVELOPMENT.md, "AURORA: podpis schválení nástrojů"),
# required with NODE_ENV=production. A random value of 32+ characters, different per environment:
# `openssl rand -base64 48`. Unset (only outside production): approvals are not signed; the server
# still re-validates every approved call (input schema, approval rule, permission).
# AI_TOOL_APPROVAL_SECRET="change-me-to-a-random-value-of-32-or-more-characters"

# Error tracking in Sentry. Unset: the SDK stays off (local development, tests). Only errors are
# sent; IP address, cookies, headers, request bodies and AI content are not collected.
# SENTRY_DSN=""
# Explicit override of the environment of the events; without it APP_ENV is used.
# SENTRY_ENVIRONMENT="staging"
