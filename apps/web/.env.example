# Local backend: `pnpm be:up` (docker-compose.yml). Use the staging values from your team instead
# to develop against the shared staging API.
NEXT_PUBLIC_API_URL=http://localhost:3247
NEXT_PUBLIC_SITE_URL=http://localhost:3047
# Must match the API's values (the Docker stack sets these). Server-only: no NEXT_PUBLIC_ prefix.
# PREVIEW_URL_SIGNING_KEY verifies the 5-minute token of a preview link; PREVIEW_API_TOKEN is sent
# to the API to read drafts and never appears in a URL (docs/DEVELOPMENT.md, "Náhled: oddělené secrety").
PREVIEW_URL_SIGNING_KEY=local-dev-preview-url-signing-key-not-secret
PREVIEW_API_TOKEN=local-dev-preview-api-token-not-a-secret
# Deprecated single secret, a fallback only while one of the two above is unset. Leave it unset.
# PREVIEW_SECRET=
REVALIDATE_SECRET=local-dev-revalidate-secret-not-for-production
# Staging project only: adds noindex (X-Robots-Tag + meta robots). Leave unset on production.
# ROBOTS_NOINDEX=true

# Sentry for the server of the web (optional, unset = off)
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=staging
