                     "type": "string",
                     "nullable": true,
                     "description": "Set when the file is in the trash. Only a project detail can show such a file (the project keeps its reference); the library and the public endpoints leave it out."
                  },
                  "publicUrl": { "type": "string" },
                  "variants": {
